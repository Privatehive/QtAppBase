<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>@info.projectName@</Name>
    <Version>@info.versionString@</Version>
    <Title>@info.projectName@ Setup</Title>
    <Publisher>@info.vendor@</Publisher>
    <ProductUrl>@info.homepage@</ProductUrl>
    <StartMenuDir>@info.projectName@</StartMenuDir>
    <TargetDir>@at@ApplicationsDirX64@at@/@info.projectName@</TargetDir>
    <RunProgram>@at@TargetDir@at@/@AppExecDir@/@AppExec@</RunProgram>
    <SupportsModify>false</SupportsModify>
    <WizardShowPageList>false</WizardShowPageList>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <AllowSpaceInPath>true</AllowSpaceInPath>
    <PersistentLocalCache>false</PersistentLocalCache>
    <RepositorySettingsPageVisible>false</RepositorySettingsPageVisible>
    @AppControlScript@
    @AppIco@
    @AppWindowIcon@
</Installer>