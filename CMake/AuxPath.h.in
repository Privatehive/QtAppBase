#pragma once
// this file is generated by register_aux_path() in QtAppBase.cmake
#include <QCoreApplication>
#include <QDir>
#include <QString>

/*!
 *
 * \brief Resolves a directory registered with register_aux_path(). The AUX_<name> macros expand to a call of this function.
 *
 * Returns the installed directory (relative to the application executable) if it exists, otherwise the directory in the
 * build tree. QCoreApplication must be instantiated before calling this function.
 *
 */
inline QString qtAppBaseAuxPath(const char *installRelativePath, const char *buildPath) {

	const QDir appDir(QCoreApplication::applicationDirPath());
	if (appDir.exists(QString::fromUtf8(installRelativePath))) {
		return QDir::cleanPath(appDir.absoluteFilePath(QString::fromUtf8(installRelativePath)));
	}
	return QString::fromUtf8(buildPath);
}

$<JOIN:$<TARGET_PROPERTY:QTAPPBASE_AUX_PATHS>,
>
