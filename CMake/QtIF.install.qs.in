function Component()
{
    // default constructor
}

Component.prototype.createOperations = function()
{
    // call default implementation to actually install
    component.createOperations();

    if (systemInfo.productType === "windows") {
        component.addOperation("CreateShortcut", "@at@TargetDir@at@/@AppExecDir@/@AppExec@", "@at@StartMenuDir@at@/@AppName@.lnk",
            "workingDirectory=@at@TargetDir@at@", "@at@TargetDir@at@/@AppExecDir@/@AppExec@",
            "iconId=1", "description=@info.projectDescription@");
    }
}